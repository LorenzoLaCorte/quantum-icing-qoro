{"parentUuid":"b57f531b-818f-4bbb-95a1-6754db1a0b5b","isSidechain":false,"promptId":"fbd7c847-bb13-4c9d-8b3d-9d904e035a94","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MYCchY54e245QoWD7hJ7HD","type":"tool_result","content":"40:def fetch_qoblib_file(rel_path: str) -> Path:\n53:def _data_rows(path: Path) -> Iterable[list[str]]:\n68:def _zround(x: Fraction) -> int:\n75:class PortfolioInstance:\n92:def load_portfolio_instance(name: str = \"po_a010_t10_orig\") -> PortfolioInstance:\n121:class PortfolioScore:\n139:class PortfolioModel:\n407:def _format_decimal(x: Fraction) -> str:\n411:def read_portfolio_solution(path: str | Path) -> tuple[dict, dict]:\n426:def fetch_portfolio_reference(instance: str, budget: int, lam_tag: str) -> Path:\n441:class PortfolioQUBO:\n609:def _as_bit_array(sample, n_vars: int) -> np.ndarray:\n624:def load_network_demand(n: int) -> np.ndarray:\n637:def all_arcs(n: int) -> list[tuple[int, int]]:\n642:def is_valid_topology(n: int, arcs: Iterable[tuple[int, int]]) -> bool:\n654:def repair_topology(\n682:def random_topology(n: int, rng: np.random.Generator) -> list[tuple[int, int]]:\n692:class NetworkRouting:\n704:def _routing_lp(demand: np.ndarray, arcs: list[tuple[int, int]]):\n742:def route_min_congestion(demand: np.ndarray, arcs: Iterable[tuple[int, int]]) -> NetworkRouting:\n759:def route_integral(\n791:def write_network_solution(path: str | Path, n: int, routing: NetworkRouting) -> int:\n806:def read_network_solution(path: str | Path) -> tuple[int, list, dict]:\n823:def check_network_solution(path: str | Path, n: int, demand: np.ndarray) -> tuple[bool, int, str]:\n851:def build_network_qubo(demand: np.ndarray) -> tuple[dimod.BinaryQuadraticModel, dimod.BinaryQuadraticModel, list]:\n881:def decode_topology(sample, arcs: list[tuple[int, int]]) -> list[tuple[int, int]]:\ndef route_min_congestion(demand: np.ndarray, arcs: Iterable[tuple[int, int]]) -> NetworkRouting:\n    \"\"\"Score a topology: solve the routing LP and round up to QOBLIB's integer objective.\n\n    The integer-flow optimum equals ``ceil`` of the LP optimum on every published\n    QOBLIB instance, so this is the score your topology will get.\n    \"\"\"\n    arcs = sorted(set(arcs))\n    var, c, A_ub, A_eq, b_eq = _routing_lp(demand, arcs)\n    res = linprog(\n        c, A_ub=A_ub, b_ub=np.zeros(A_ub.shape[0]), A_eq=A_eq, b_eq=b_eq,\n        bounds=(0, None), method=\"highs\",\n    )\n    if res.status != 0:\n        return NetworkRouting(math.inf, math.inf, arcs)\n    return NetworkRouting(float(math.ceil(res.fun - 1e-6)), float(res.fun), arcs)\n\n\ndef route_integral(\n    demand: np.ndarray, arcs: Iterable[tuple[int, int]], time_limit: float = 60.0\n) -> NetworkRouting:\n    \"\"\"Integer flows achieving the topology's score (needed to write a solution file).\"\"\"\n    arcs = sorted(set(arcs))\n    var, c, A_ub, A_eq, b_eq = _routing_lp(demand, arcs)\n    lp = route_min_congestion(demand, arcs)\n    if math.isinf(lp.objective):\n        return lp\n    lower = np.zeros(len(c))\n    lower[-1] = lp.objective  # the LP bound, rounded up, is a valid lower bound\n    integrality = np.ones(len(c))\n    res = milp(\n        c,\n        constraints=[\n            _LPConstraint(A_ub, -np.inf, 0.0),\n            _LPConstraint(A_eq, b_eq, b_eq),\n        ],\n        integrality=integrality,\n        bounds=Bounds(lower, np.full(len(c), np.inf)),\n        options={\"time_limit\": time_limit},\n    )\n    if res.x is None:\n        raise RuntimeError(f\"integral routing failed: {res.message}\")\n    x = np.round(res.x).astype(np.int64)\n    flows = {(k, *arcs[a]): int(x[idx]) for (k, a), idx in var.items() if x[idx]}\n    arc_load = {a: 0 for a in arcs}\n    for (k, i, j), f in flows.items():\n        arc_load[i, j] += f\n    return NetworkRouting(float(max(arc_load.values())), lp.z_lp, arcs, flows)\n\n\ndef write_network_solution(path: str | Path, n: int, routing: NetworkRouting) -> int:\n    \"\"\"Write a QOBLIB/Gurobi-style ``.sol`` file (1-indexed) and return its objective.\"\"\"\n    if routing.flows is None:\n        raise ValueError(\"compute integer flows first with route_integral()\")\n    arcs = set(routing.arcs)\n    z = int(routing.objective)\n    lines = [\"# Solution for model obj\", f\"# Objective value = {z}\", f\"z {z}\"]\n    lines += [f\"x#{i + 1}#{j + 1} {int((i, j) in arcs)}\" for i, j in all_arcs(n)]\n    lines += [\n        f\"f#{k + 1}#{i + 1}#{j + 1} {f}\" for (k, i, j), f in sorted(routing.flows.items())\n    ]\n    Path(path).write_text(\"\\n\".join(lines) + \"\\n\")\n    return z\n\n\ndef read_network_solution(path: str | Path) -> tuple[int, list, dict]:\n    \"\"\"Read a network ``.sol`` file → ``(z, arcs, flows)``, 0-indexed.\"\"\"\n    z, arcs, flows = 0, [], {}\n    for line in Path(path).read_text().splitlines():\n        line = line.strip()\n        if m := re.match(r\"^z\\s+(\\d+)$\", line):\n            z = int(m.group(1))\n        elif m := re.match(r\"^x#(\\d+)#(\\d+)\\s+(\\d+)$\", line):\n            if int(m.group(3)):\n                arcs.append((int(m.group(1)) - 1, int(m.group(2)) - 1))\n        elif m := re.match(r\"^f#(\\d+)#(\\d+)#(\\d+)\\s+(\\d+)$\", line):\n            k, i, j, f = (int(g) for g in m.groups())\n            if f:\n                flows[k - 1, i - 1, j - 1] = f\n    return z, arcs, flows","is_error":false}]},"uuid":"b37f627e-4b11-4c94-bf9a-ecd57c0b60ae","timestamp":"2026-11-21T20:12:05.863Z","toolUseResult":{"stdout":"40:def fetch_qoblib_file(rel_path: str) -> Path:\n53:def _data_rows(path: Path) -> Iterable[list[str]]:\n68:def _zround(x: Fraction) -> int:\n75:class PortfolioInstance:\n92:def load_portfolio_instance(name: str = \"po_a010_t10_orig\") -> PortfolioInstance:\n121:class PortfolioScore:\n139:class PortfolioModel:\n407:def _format_decimal(x: Fraction) -> str:\n411:def read_portfolio_solution(path: str | Path) -> tuple[dict, dict]:\n426:def fetch_portfolio_reference(instance: str, budget: int, lam_tag: str) -> 